# Production environment template.
#
# Copy to deploy/.env on the server (never commit it) and fill in real values.
# `docker compose -f deploy/docker-compose.prod.yml` loads deploy/.env automatically.

# --- Database ---
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=pos_db
SSL_MODE=disable

# --- API ---
JWT_SECRET=change-me-long-random-secret
PORT=8080

# Seeding is disabled in production. Bootstrap the admin once with:
#   docker compose -f deploy/docker-compose.prod.yml exec api /app/api reset-admin
# It uses DEFAULT_ADMIN_PASSWORD (or -password) and creates/updates the admin.
SEED_DEFAULT_ACCOUNT=false
SEED_DEMO_DATA=false
DEFAULT_ADMIN_PASSWORD=change-me-strong-admin-password

# --- Web ---
WEB_PORT=80
