# Backend (API) Configuration
PORT=8080
JWT_SECRET=supersecretkey
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pos_db
# docker-compose.yml maps this host port to PostgreSQL 5432.
# Use 5433 when a local PostgreSQL already occupies 5432.
DB_PORT=5432
SSL_MODE=disable

# Seeder (set false in production)
SEED_DEFAULT_ACCOUNT=true

# Frontend (Platform) Configuration
VITE_API_URL=http://localhost:8080/api
